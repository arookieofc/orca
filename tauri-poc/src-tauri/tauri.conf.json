{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orca",
  "version": "1.4.214",
  "identifier": "com.stablyai.orca",
  "build": {
    "beforeDevCommand": "pnpm exec vite --config vite.web.config.ts --host 127.0.0.1 --port 5174 --strictPort",
    "devUrl": "http://127.0.0.1:5174/web-index.html",
    "beforeBuildCommand": "node tauri-poc/scripts/sync-tauri-version.mjs && pnpm run build:web && pnpm run build:mobile-web && pnpm run build:orcad && node tauri-poc/scripts/prepare-release-runtime.mjs && node tauri-poc/scripts/prepare-web-dist.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Orca",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 16, "y": 12 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "resources": {
      "../resources/orcad": "orcad",
      "../resources/runtimes": "runtimes",
      "../resources/node_modules": "node_modules"
    },
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "entitlements": "../../resources/build/entitlements.mac.plist"
    }
  }
}
